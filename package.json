{
  "name": "reelscribe",
  "version": "1.0.1",
  "description": "Official Node.js/TypeScript SDK for the ReelScribe API — transcribe Instagram Reels, TikTok videos, and YouTube shorts programmatically.",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "reelscribe",
    "transcription",
    "instagram",
    "tiktok",
    "youtube",
    "reels",
    "shorts",
    "video",
    "api",
    "sdk",
    "speech-to-text"
  ],
  "author": "SIAN Agency (https://sian-agency.online)",
  "license": "MIT",
  "homepage": "https://www.reelscribe.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/rara-cyber/reelscribe-js.git"
  },
  "bugs": {
    "url": "https://github.com/rara-cyber/reelscribe-js/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.4.0"
  }
}
